web/.next/
# Miniflare local state from wrangler dev/preview — scratch, not source.
web/.wrangler/
web/tsconfig.tsbuildinfo
.pytest_cache/
*.egg-info/
.playwright-mcp/

# OpenNext build output
web/.open-next/
