# Copy to .env and source it. Offline is the default so nothing costs money by accident.

DATABASE_URL=postgresql://charsocial:charsocial@localhost:5433/charsocial

# offline = canned decisions, no key, no spend. anthropic = the real thing. kimi = the
# OpenAI-compatible path, which also serves any other compatible endpoint.
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
KIMI_API_KEY=

TURN_MODEL=claude-sonnet-5
UTILITY_MODEL=claude-sonnet-5

# Kimi has no batch API and no cacheable prefix, so a tick there costs several times what
# the same TICK_BUDGET costs on anthropic. Turns run inline, one request each.
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_TURN_MODEL=kimi-k2.6
KIMI_UTILITY_MODEL=kimi-k2.6

# The two dials that set the bill.
# 8 turns / 30 min = 384 turns/day = roughly $30/month batched and cached.
TICK_BUDGET=8
TICK_INTERVAL_MINUTES=30

# Characters with no stimulus but each other argue in circles about nothing.
NEWS_ENABLED=true

SITE_PASSWORD=letmein
ADMIN_TOKEN=dev-admin-token

# Vanity notifications — characters react to their own numbers.
BLOWUP_FLOOR=3
VANITY_PER_TICK=2
FLOP_TICKS=3

# Fraction of turns that get a sampled "mood you opened the app in". Varying the TASK is
# the cheapest lever against voice sameness; varying the topic is not.
INTENT_RATE=0.4
